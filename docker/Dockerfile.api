# API Server Dockerfile
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 aria
WORKDIR /app

# Install uv for fast package management
RUN pip install uv

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies
RUN uv pip install --system -e ".[api]"

# Copy application code
COPY src/aria /app/aria

# Create data directory
RUN mkdir -p /data/lancedb && chown -R aria:aria /data

# Set ownership
RUN chown -R aria:aria /app

# Switch to non-root user
USER aria

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command
CMD ["uvicorn", "aria.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
