# Hydration Stack Configuration
# Copy to terraform.tfvars and customize

aws_region  = "us-east-1"
environment = "dev"
name_prefix = "aria"

# From shared stack outputs
eks_cluster_name  = "aria-eks"
eks_node_role_arn = "arn:aws:iam::ACCOUNT_ID:role/aria-eks-node-role"
subnet_ids        = ["subnet-xxx", "subnet-yyy", "subnet-zzz"]

# GPU Node Group
gpu_instance_types = ["g4dn.xlarge", "g4dn.2xlarge"]
gpu_min_size       = 0
gpu_max_size       = 10
gpu_desired_size   = 0

# Cost optimization
use_spot_instances = true
